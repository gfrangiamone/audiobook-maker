# =============================================================================
#  AudioBook-Maker — Configurazione Gemini TTS per piano "Tier 1" (billing attivo)
# =============================================================================
#
#  Copia questo file in `.env` (o esportalo nel tuo ambiente) e aggiorna i valori
#  in base al tuo profilo Google AI Studio / Cloud.
#
#  Riferimento limiti Tier 1 (consultare la dashboard Google per i valori
#  aggiornati: https://aistudio.google.com/app/usage):
#
#    Modello                           RPM   RPD   TPM
#    gemini-2.5-flash-preview-tts      ~1000 100   varia
#    gemini-3.1-flash-tts (preview)    ~120  100   varia
#
#  ATTENZIONE: il limite RPD del Tier 1 sui modelli TTS è di 100 richieste/giorno
#  PER MODELLO. È molto basso e va considerato la metrica di costo principale,
#  non i token. Strategie pratiche per non saturarlo:
#    - chunk testo più grossi (vedi ABM_GEMINI_MAX_BYTES_PER_CALL)
#    - non sprecare anteprime (vedi ABM_GEMINI_PREVIEW_CAP_PER_DAY)
#    - in caso di 429 daily, ABM_GEMINI_ABORT_ON_QUOTA evita retry inutili.
# =============================================================================


# -----------------------------------------------------------------------------
#  Autenticazione
# -----------------------------------------------------------------------------
# Usa Vertex (true) o Gemini API key (false). Per Tier 1 standard => false.
ABM_GEMINI_USE_VERTEX=false

# API key Google AI Studio con billing attivo.
ABM_GEMINI_API_KEY=AIza_TUA_KEY_QUI

# Solo se ABM_GEMINI_USE_VERTEX=true:
# ABM_GEMINI_VERTEX_CREDENTIALS_FILE=/path/to/service-account.json


# -----------------------------------------------------------------------------
#  Chunking
# -----------------------------------------------------------------------------
# Massimo byte testo per singola call. 4000 è il default conservativo.
# In Tier 1 puoi alzarlo a 5000–6000 se hai testi molto puliti.
ABM_GEMINI_MAX_BYTES_PER_CALL=4000


# -----------------------------------------------------------------------------
#  RPM throttle (intervallo minimo tra chiamate, per modello, in millisecondi)
#  Tier 1: la finestra RPM è ampia, quindi bastano 200ms su flash25 (~300 RPM
#  reali) e 500ms su flash31 (~120 RPM reali).
# -----------------------------------------------------------------------------
ABM_GEMINI_MIN_INTERVAL_FLASH25_MS=200
ABM_GEMINI_MIN_INTERVAL_FLASH31_MS=500


# -----------------------------------------------------------------------------
#  RPD (Requests Per Day) — contatore locale
#  Imposta un cap SOTTO il limite reale Google per evitare 429 a fine giornata.
#  Lascia 0 per disabilitare.
#
#  Tier 1 TTS attuale = 100 RPD per modello. Tenendo conto della SAFETY_RESERVE
#  qui sotto (10), il job verrà bloccato a 90 richieste effettive consumate,
#  lasciando 10 richieste libere per retry/emergenze prima del 429 reale.
# -----------------------------------------------------------------------------
ABM_GEMINI_RPD_FLASH25=100
ABM_GEMINI_RPD_FLASH31=100

# Riserva di sicurezza (richieste lasciate libere per emergenze / retry).
ABM_GEMINI_RPD_SAFETY_RESERVE=10


# -----------------------------------------------------------------------------
#  Retry policy
# -----------------------------------------------------------------------------
# Numero massimo di tentativi per chunk (incluso il primo).
# In Tier 1 con throttle attivo bastano 3 tentativi.
ABM_GEMINI_SYNTH_MAX_ATTEMPTS=3

# Se true, il retry rispetta il `retryDelay` indicato dall'API nel 429
# (consigliato: evita di sprecare quota con backoff cieco).
ABM_GEMINI_RETRY_HONOR_DELAY=true

# Tempo massimo (sec) per cui il sistema accetta di attendere un retryDelay.
# Sopra questa soglia, considera la quota esaurita e mette il job in pausa.
# 60s è un buon compromesso. Aumenta solo se preferisci attese più lunghe.
ABM_GEMINI_RETRY_MAX_WAIT_SEC=60

# Se true, su 429 "daily quota exhausted" interrompe immediatamente il job
# (consigliato in Tier 1: l'evento è raro e l'attesa di ore non ha senso).
ABM_GEMINI_ABORT_ON_QUOTA=true


# -----------------------------------------------------------------------------
#  Budget guard (in EUR)
#  0 = disabilitato. Tier 1 con billing attivo => raccomandato impostarli.
# -----------------------------------------------------------------------------
# Cap giornaliero totale (somma costi di tutti i job).
ABM_GEMINI_DAILY_BUDGET_EUR=200.00

# Cap per singolo job (libro).
ABM_GEMINI_PER_JOB_BUDGET_EUR=100.00

# Soglia % oltre la quale viene loggato un warning ("80% di budget consumato").
ABM_GEMINI_BUDGET_ALERT_PCT=90

# Se true, raggiunto il cap il job viene messo in pausa.
# Se false, viene solo loggato un warning (non consigliato in produzione).
ABM_GEMINI_BUDGET_HARD_STOP=true


# -----------------------------------------------------------------------------
#  Qualità / robustezza del job finale
# -----------------------------------------------------------------------------
# Frazione massima di chunk falliti tollerata prima di marcare il job
# come "partial" anziché "done". 0.05 = 5%.
# In Tier 1 con throttle attivo, valori realistici sono 0.01–0.05.
ABM_GEMINI_MAX_FAILED_RATIO=0.05


# -----------------------------------------------------------------------------
#  Modalità billing token-counting (lasciare "prompt" salvo motivi specifici)
#  - "prompt":    fattura solo i prompt tokens (sconsigliato per audio TTS)
#  - "token":     fattura input + output tokens (default Google)
#  - "estimate":  usa stima caratteri x 4 senza chiamare countTokens()
# -----------------------------------------------------------------------------
ABM_GEMINI_RATE_MODE=prompt


# =============================================================================
#  ────────────────  PREZZI & MARGINI MODELLI Gemini TTS  ────────────────
# =============================================================================
#  Aggiornare in base ai listini Google AI Studio. Valori in USD per 1M token.
#  Il prezzo finale all'utente = (input_tokens × INPUT) + (output_tokens × OUTPUT)
#  convertito in EUR e maggiorato del MARGIN_PERCENT.
# -----------------------------------------------------------------------------

# --- gemini-2.5-flash-preview-tts (modello "flash25" — economico, IT/EN ok) ---
ABM_GEMINI_25FLASH_INPUT_USD_PER_MTOK=0.50
ABM_GEMINI_25FLASH_OUTPUT_USD_PER_MTOK=10.00
# Margine sul costo Google (es. 35.0 = +35%).
ABM_GEMINI_25FLASH_MARGIN_PERCENT=35.0

# --- gemini-3.1-flash-tts (modello "flash31" — qualità premium, +costoso) -----
ABM_GEMINI_31FLASH_INPUT_USD_PER_MTOK=1.00
ABM_GEMINI_31FLASH_OUTPUT_USD_PER_MTOK=20.00
ABM_GEMINI_31FLASH_MARGIN_PERCENT=25.0


# -----------------------------------------------------------------------------
#  Conversione valuta e commissioni di pagamento
#  Il prezzo mostrato all'utente parte dal costo Google USD, viene convertito
#  in EUR e poi maggiorato per coprire le fees PayPal residue.
# -----------------------------------------------------------------------------

# Tasso di conversione USD -> EUR. Aggiornare periodicamente (es. mensile).
ABM_GEMINI_USD_EUR_RATE=0.86

# Fee fissa PayPal per transazione (in EUR). Default conservativo 0.34 €.
ABM_GEMINI_PAYPAL_FIXED_FEE_EUR=0.34

# Fee percentuale PayPal (es. 3.4 = 3.4%).
ABM_GEMINI_PAYPAL_PERCENT_FEE=3.4


# -----------------------------------------------------------------------------
#  Anteprima audio ("preview") — rate limiting per IP/sessione
#  Le preview consumano quota Gemini ma sono offerte gratuitamente all'utente:
#  serve un cap per evitare abusi.
# -----------------------------------------------------------------------------

# Numero massimo di preview consentite per utente nella finestra mobile.
# Con 100 RPD totali del Tier 1, ogni preview = 1% del budget giornaliero:
# tenerlo basso (2-3) evita che gli utenti curiosi brucino la quota destinata
# ai job di produzione.
ABM_GEMINI_PREVIEW_CAP_PER_DAY=3

# Ampiezza della finestra mobile in secondi (300s = 5 min).
ABM_GEMINI_PREVIEW_WINDOW_SEC=300


# -----------------------------------------------------------------------------
#  Rate logging per stima durata audio
#  Il sistema misura il rapporto reale audio/token su un campione mobile per
#  affinare la stima durata e il costo predetto sui prossimi job.
# -----------------------------------------------------------------------------

# Quantità totale di campioni conservati nel log (finestra storica).
ABM_GEMINI_RATE_LOG_MAX_SAMPLES=2000

# Numero di campioni più recenti usati per calcolare la media corrente.
ABM_GEMINI_RATE_LOG_WINDOW=20

# Minimo di campioni richiesti prima di usare la media misurata (sotto
# questa soglia si usa il rate teorico statico).
ABM_GEMINI_RATE_LOG_MIN_SAMPLES=5


# -----------------------------------------------------------------------------
#  Ottimizzazione testo AI (passa prima della sintesi Gemini TTS)
#  Il flusso "Premium" può attivare un passo di pulizia/ottimizzazione testo
#  via LLM prima del TTS. Il costo viene SOMMATO al preventivo Gemini per
#  determinare l'addebito totale all'utente (combined_estimate).
# -----------------------------------------------------------------------------

# Tariffa LLM in EUR per milione di caratteri PROCESSATI.
# Esempio: 1.10 € / Mchar -> un libro da 500k char costa 0.55 € di sola
# ottimizzazione, in aggiunta al costo Gemini TTS.
ABM_LLM_RATE_EUR_PER_MCHAR=1.10

# Soglia "gratuita" per l'ottimizzazione AI: sotto questa cifra il passo è
# offerto senza addebito (assorbito nel margine). Indipendente dalla soglia
# Gemini TTS perché può essere attivato anche senza voci PREMIUM.
ABM_LLM_FREE_THRESHOLD_EUR=0.50


# -----------------------------------------------------------------------------
#  Soglia notifica "voce premium" (sotto questa cifra il job è considerato
#  "gratuito" per l'utente e non genera un addebito; sopra, parte il flusso
#  di pagamento). Tier 1: tipicamente 0.50 EUR.
#  NB: questa soglia confronta SOLO la quota Gemini TTS del totale; il costo
#  LLM va sopra ABM_LLM_FREE_THRESHOLD_EUR per attivare anche quel flusso.
# -----------------------------------------------------------------------------
ABM_GEMINI_FREE_THRESHOLD_EUR=0.50
